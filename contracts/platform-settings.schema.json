{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-platform.local/contracts/platform-settings/0.3.0",
  "title": "Platform Runtime Settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "services", "agent", "voice", "features"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "0.3.0"},
    "revision": {"type": "integer", "minimum": 1},
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web_ui", "core_agent", "orchestrator", "rag", "voice_runtime"],
      "properties": {
        "web_ui": {"$ref": "#/$defs/httpService"},
        "core_agent": {"$ref": "#/$defs/httpService"},
        "orchestrator": {"$ref": "#/$defs/httpService"},
        "memory_context": {"$ref": "#/$defs/httpService"},
        "rag": {"$ref": "#/$defs/httpService"},
        "voice_runtime": {"$ref": "#/$defs/webSocketService"},
        "searxng": {"$ref": "#/$defs/httpService"}
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "model_base_url", "timeout_seconds", "max_tool_steps"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "model_base_url": {"type": "string", "format": "uri"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "max_tool_steps": {"type": "integer", "minimum": 1, "maximum": 32},
        "knowledge_cutoff": {"type": "string", "format": "date"}
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tts_provider", "tts_voice", "tts_language", "tts_auto_language_routing", "barge_in_enabled"],
      "properties": {
        "tts_provider": {"type": "string", "minLength": 1},
        "tts_voice": {"type": "string", "minLength": 1},
        "tts_language": {"type": "string", "minLength": 1},
        "tts_auto_language_routing": {"type": "boolean"},
        "barge_in_enabled": {"type": "boolean"}
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rag_enabled"],
      "properties": {"rag_enabled": {"type": "boolean"}}
    }
  },
  "$defs": {
    "httpService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {"url": {"type": "string", "format": "uri", "pattern": "^https?://127\\.0\\.0\\.1:"}}
    },
    "webSocketService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {"url": {"type": "string", "format": "uri", "pattern": "^wss?://127\\.0\\.0\\.1:"}}
    }
  }
}
